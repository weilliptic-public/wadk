# Every environment variable the Java SDK and its examples read.
# Copy to .env, fill in your own values, and never commit .env.
#
# Load it in the command that runs an agent, from adk/java:
#   (set -a; source .env; set +a; mvn -q compile exec:java -Dexec.mainClass=<agent class>)

# ── Wallet (required: one of the two) ────────────────────────────────────────
# Agent Registry API key; Sentinel holds the private key and signs for it.
WEIL_AGENT_KEY=
# Or a local wallet file instead of the key:
# WEIL_WALLET_FILE=/path/to/wallet.wc

# The Sentinel node. Unset means production, https://sentinel.weilliptic.ai.
# SENTINEL_HOST=

# 0 skips TLS certificate checks, for a local development Sentinel only.
# Never set it in production; trust the Sentinel's CA instead (adk/README.md).
# WEIL_TLS_VERIFY=0

# ── Model ────────────────────────────────────────────────────────────────────
# anthropic (default) or openai.
MODEL_PROVIDER=anthropic

# Anthropic, when MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5
# ANTHROPIC_BASE_URL=
# 1 or 0 turns prompt caching on or off (on by default for Anthropic's own API)
# CLAUDE_PROMPT_CACHE=1

# OpenAI, or any OpenAI-compatible server, when MODEL_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=http://localhost:8000/v1

# ── Agents that call other agents ────────────────────────────────────────────
# Travel planner: where the flights and hotels agents serve
# FLIGHTS_URL=http://127.0.0.1:8001
# HOTELS_URL=http://127.0.0.1:8002
# a2a_basic (dice agent): where the prime agent serves
# PRIME_URL=http://127.0.0.1:8003

# How long a remote agent call may take, in seconds (default 300)
# WEIL_A2A_TIMEOUT_SECONDS=300
# 0 silences the one-line console trace of each remote call
# WEIL_A2A_DEBUG=0

# ── Agents served over A2A (flights, hotels, prime) ──────────────────────────
# The group a caller's wallet must be permitted in. Unset: any signed wallet may call.
# WEIL_SERVICE=

# Each served agent listens on PORT if set, else its own port (8001, 8002, 8003).
# Set PORT per agent (shell, Dockerfile or Compose), not in a shared .env.
# PORT=

# In a container: listen on all interfaces, and name the URL callers use.
# WEIL_A2A_BIND=0.0.0.0
# WEIL_A2A_PUBLIC_URL=http://flights:8001/

# ── Single agents ────────────────────────────────────────────────────────────
# mcpfilesystem: the only folder it may touch (needs Node.js)
# MCP_FS_ROOT=/tmp/mcp-demo

# financialadvisor: the web search applet (default websearch::<your org>)
# WEIL_SEARCH_APPLET=

# Spring chat apps (examples-web): keep localhost, they have no login
# SERVER_ADDRESS=localhost
