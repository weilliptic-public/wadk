<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.weilliptic</groupId>
    <artifactId>weil-wallet-examples-web</artifactId>
    <version>1.0.0-SNAPSHOT</version>

    <!--
      ADK's dev UI, and the Spring Boot chat apps ported from ADK's
      spring_chat and spring_chat_advanced, in a module of their own.

      It cannot live in the SDK's own build: the dev UI runs on Spring Boot 4
      (Spring Framework 7, jakarta.servlet), while the SDK's optional spring/
      integration is built against Spring 5 and javax.servlet. On one classpath
      Maven picks Spring 5 by nearest-declaration and the dev UI dies with
      NoSuchMethodError. So the SDK is depended on here with its Spring
      excluded, and this module brings its own.
    -->
    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>ai.weilliptic</groupId>
            <artifactId>weil-wallet</artifactId>
            <version>0.2.1</version>
        </dependency>
        <dependency>
            <groupId>com.google.adk</groupId>
            <artifactId>google-adk-dev</artifactId>
            <version>1.11.0</version>
        </dependency>
        <!--
          Pinned ahead of the 1.7.32 that bitcoinj pulls in: Spring Boot's
          Logback is 1.5.x and binds to the slf4j 2 API, and with 1.7 on the
          classpath it refuses to start at all.
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.17</version>
        </dependency>
        <!--
          Pinned ahead of the SDK's 2.16.1. jackson-annotations arrives at 2.20
          from Spring Boot's side, and the 2.20 line calls
          PropertyName.merge(), added in databind 2.19, so 2.16.1 on the
          classpath makes every request that serializes a response fail with
          NoSuchMethodError.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.20.2</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
            <version>2.20.2</version>
        </dependency>
    </dependencies>
</project>
