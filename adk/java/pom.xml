<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.weilliptic</groupId>
    <artifactId>weil-wallet</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>Weil Wallet SDK for Java</name>
    <description>WeilChain wallet, client, and agent with audit capabilities</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- What a bare `mvn exec:java` runs; pick another with -Dexec.mainClass=... -->
        <exec.mainClass>com.weilliptic.weilwallet.examples.AuditExample</exec.mainClass>
    </properties>

    <dependencies>
        <!-- Google ADK for Java: agents, tools, and the Plugin hook interface -->
        <dependency>
            <groupId>com.google.adk</groupId>
            <artifactId>google-adk</artifactId>
            <version>1.11.0</version>
        </dependency>
        <!-- A2A: ADK's executor and remote agent, over the a2a-java SDK -->
        <dependency>
            <groupId>com.google.adk</groupId>
            <artifactId>google-adk-a2a</artifactId>
            <version>1.11.0</version>
        </dependency>
        <!-- OpenAI, or any OpenAI-compatible server, as an ADK model: ADK's
             LangChain4j adapter over LangChain4j's OpenAI client. Used when
             MODEL_PROVIDER=openai; see WeilAgentSetup.model(). -->
        <dependency>
            <groupId>com.google.adk</groupId>
            <artifactId>google-adk-langchain4j</artifactId>
            <version>1.11.0</version>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai</artifactId>
            <version>1.12.2</version>
        </dependency>
        <!-- A2A server side: request handling and the JSON-RPC transport -->
        <dependency>
            <groupId>io.github.a2asdk</groupId>
            <artifactId>a2a-java-sdk-server-common</artifactId>
            <version>0.3.2.Final</version>
        </dependency>
        <dependency>
            <groupId>io.github.a2asdk</groupId>
            <artifactId>a2a-java-sdk-transport-jsonrpc</artifactId>
            <version>0.3.2.Final</version>
        </dependency>
        <dependency>
            <groupId>io.github.a2asdk</groupId>
            <artifactId>a2a-java-sdk-client-transport-jsonrpc</artifactId>
            <version>0.3.2.Final</version>
        </dependency>
        <!-- secp256k1, BIP32, BIP39 -->
        <dependency>
            <groupId>org.bitcoinj</groupId>
            <artifactId>bitcoinj-core</artifactId>
            <version>0.16.2</version>
        </dependency>
        <!-- Keccak-256 for derived address -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.78.1</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.16.1</version>
        </dependency>
        <dependency>
            <groupId>commons-codec</groupId>
            <artifactId>commons-codec</artifactId>
            <version>1.16.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>audit-example</id>
                        <phase>none</phase>
                        <configuration>
                            <mainClass>com.weilliptic.weilwallet.examples.AuditExample</mainClass>
                        </configuration>
                        <goals>
                            <goal>java</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>agent-example</id>
                        <phase>none</phase>
                        <configuration>
                            <mainClass>com.weilliptic.weilwallet.examples.WeilAgentAuditExample</mainClass>
                        </configuration>
                        <goals>
                            <goal>java</goal>
                        </goals>
                    </execution>
                </executions>
                <!-- No <configuration><mainClass> here: a value set in the plugin's
                     configuration beats -Dexec.mainClass on the command line, so
                     every example would run AuditExample. The default lives in
                     the exec.mainClass property instead, which -D overrides. -->
            </plugin>
        </plugins>
    </build>
</project>
