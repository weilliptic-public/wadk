# Copy to .env and fill in. The example is live-only: a missing required value
# raises before any work is done rather than falling back to a default.

# --- required ----------------------------------------------------------------
OPENAI_API_KEY=

# Agent identities — one per agent, so each wallet identity is distinct.
WEIL_IDENTITY_INTAKE=
WEIL_IDENTITY_CATEGORIZER=
WEIL_IDENTITY_ROUTER=
WEIL_IDENTITY_RESOLVER=

# --- required only if your Agent Registry wallets are externally stored -------
# Sentinel answers "Storage Credentials are required" without these.
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are accepted as fallbacks.
WEIL_S3_ACCESS_KEY=
WEIL_S3_SECRET_KEY=

# --- optional ----------------------------------------------------------------
# S3 location for the same lookup (AWS_REGION / AWS_S3_BUCKET also accepted).
WEIL_S3_REGION=
WEIL_S3_BUCKET=

# Sentinel base URL — backs wallet lookup, audit-contract resolution and signing
# alike. Defaults to weil_wallet.constants.SENTINEL_HOST.
SENTINEL_HOST=

# Chat model for categorizer / router / resolver. Defaults to gpt-4o-mini.
OPENAI_MODEL=
